---
import { faqs } from '../data/content';
---
<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="container grid">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Questions</p>
      <h2 id="faq-h">Common questions, answered plainly.</h2>
      <p>Don’t see yours? <a href="#contact">Just ask me.</a></p>
    </div>
    <div class="list" data-reveal>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="ans"><div><p>{f.a}</p></div></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--s-6); }
  .section-head { margin-bottom: 0; align-content: start; }
  .section-head a { color: var(--c-text); border-bottom: 1px solid var(--c-blue-line); }
  .list { border-top: 1px solid var(--c-border); }
  details { border-bottom: 1px solid var(--c-border); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding: var(--s-5) 0; min-height: 56px; font-family: var(--f-display); font-size: var(--t-md); font-weight: 500; transition: color var(--d-fast); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: var(--f-mono); font-size: 1.4rem; color: var(--c-blue); flex: none; transition: transform var(--d-base) var(--ease-out); }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { color: var(--c-blue); }
  .ans { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--d-base) var(--ease-out); }
  .ans > div { overflow: hidden; }
  details[open] .ans { grid-template-rows: 1fr; }
  .ans p { padding-bottom: var(--s-5); color: var(--c-text-2); max-width: 60ch; }
  @media (min-width: 960px) {
    .grid { grid-template-columns: 5fr 7fr; gap: var(--s-9); }
    .section-head { position: sticky; top: calc(var(--nav-h) + var(--s-6)); height: fit-content; }
  }
</style>

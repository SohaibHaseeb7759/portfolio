---
import { nav, site, mailtoHref, whatsappHref } from '../data/site';
import Icon from './Icon.astro';
const wa = whatsappHref();
---
<footer class="footer">
  <div class="container top">
    <div class="brand">
      <a href="#top" class="name">Sohaib Haseeb</a>
      <p>Websites and web applications for businesses that want to look professional and be easy to reach.</p>
    </div>
    <nav aria-label="Footer"><h2>Sections</h2><ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
    <div><h2>Get in touch</h2>
      <ul>
        {site.contact.email && <li><a href={mailtoHref()}>{site.contact.email}</a></li>}
        {wa && <li><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>}
      </ul>
      <ul class="social">
        {site.social.github && <li><a href={site.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a></li>}
        {site.social.linkedin && <li><a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>}
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <p>© <span data-year>2026</span> {site.name}. Designed and built in {site.location.split(',')[0]} with Astro.</p>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
<script>document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));</script>

<style>
  .footer { border-top: 1px solid var(--c-border); padding-top: var(--s-8); background: var(--c-surface-1); }
  @media (max-width: 859px) { .footer { padding-bottom: calc(72px + env(safe-area-inset-bottom)); } }
  .top { display: grid; gap: var(--s-7); padding-bottom: var(--s-8); }
  .name { font-family: var(--f-display); font-size: var(--t-xl); font-weight: 600; letter-spacing: -0.02em; }
  .brand p { color: var(--c-text-2); font-size: var(--t-sm); max-width: 36ch; margin-top: var(--s-3); }
  h2 { font-family: var(--f-mono); font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-text-3); font-weight: 500; margin-bottom: var(--s-4); }
  ul { display: grid; gap: var(--s-2); }
  li a { color: var(--c-text-2); font-size: var(--t-sm); transition: color var(--d-fast); display: inline-block; padding-block: 12px; min-width: 44px; word-break: break-all; }
  li a:hover { color: var(--c-text); }
  .social { display: flex; gap: var(--s-3); margin-top: var(--s-4); }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--c-border-strong); border-radius: var(--r-sm); padding: 0; }
  .social a:hover { border-color: var(--c-blue); }
  .social :global(svg) { width: 18px; height: 18px; }
  .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s-3); padding-block: var(--s-5); border-top: 1px solid var(--c-border); font-size: var(--t-xs); color: var(--c-text-3); }
  .bottom a { padding-block: 12px; margin-block: -12px; }
  .bottom a:hover { color: var(--c-text); }
  @media (min-width: 800px) { .top { grid-template-columns: 2fr 1fr 1.4fr; } }
</style>

---
import { tech } from '../data/content';
---
<section class="tech" aria-labelledby="tech-h">
  <div class="container wrap" data-reveal>
    <div>
      <h2 id="tech-h">For the curious: tools I use</h2>
      <p>You don’t need to know any of this to work with me. It’s here in case you or your IT person wonder.</p>
    </div>
    <ul>{tech.map((t) => <li class="tag">{t}</li>)}</ul>
  </div>
</section>

<style>
  .tech { padding-block: var(--s-8); border-top: 1px solid var(--c-border); }
  .wrap { display: grid; gap: var(--s-5); align-items: center; }
  h2 { font-size: var(--t-md); font-family: var(--f-mono); font-weight: 500; letter-spacing: 0; margin-bottom: var(--s-2); }
  p { color: var(--c-text-3); font-size: var(--t-sm); max-width: 44ch; }
  ul { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (min-width: 900px) { .wrap { grid-template-columns: 1fr 1.4fr; gap: var(--s-8); } }
</style>

---
import { Image } from 'astro:assets';
import { beforeAfter } from '../data/content';
---
{beforeAfter.length > 0 && (
  <section class="section" id="redesigns" aria-labelledby="ba-h">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Before &amp; after</p>
        <h2 id="ba-h">What a redesign can look like.</h2>
        <p>Drag the handle, or use the arrow keys, to compare.</p>
      </div>
      <div class="list">
        {beforeAfter.map((b) => (
          <figure data-reveal>
            <div class="ba" data-ba style="--pos:50%">
              <Image src={b.after} alt={`${b.title}: after redesign`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 800px, 92vw" loading="lazy" />
              <div class="ba__before"><Image src={b.before} alt={`${b.title}: before redesign`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 800px, 92vw" loading="lazy" /></div>
              <span class="ba__tag ba__tag--l" aria-hidden="true">Before</span><span class="ba__tag ba__tag--r" aria-hidden="true">After</span>
              <div class="ba__handle" role="slider" tabindex="0" aria-label={`Compare before and after for ${b.title}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50% before"><span aria-hidden="true">⇆</span></div>
            </div>
            <figcaption>{b.title}{b.concept && <em> · Concept redesign, not commissioned</em>}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .list { display: grid; gap: var(--s-7); }
  figure { margin: 0; }
  .ba { --pos: 50%; position: relative; overflow: hidden; border-radius: var(--r-md); border: 1px solid var(--c-border-strong); touch-action: pan-y; user-select: none; }
  .ba :global(img) { width: 100%; height: auto; display: block; }
  .ba__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__before :global(img) { height: 100%; object-fit: cover; object-position: left top; }
  .ba__tag { position: absolute; top: 10px; font-family: var(--f-mono); font-size: var(--t-xs); background: #000b; color: #fff; padding: 3px 10px; border-radius: var(--r-pill); }
  .ba__tag--l { left: 10px; } .ba__tag--r { right: 10px; }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 44px; margin-left: -22px; display: grid; place-items: center; cursor: ew-resize; }
  .ba__handle::before { content: ''; position: absolute; inset: 0 21px; background: #fff; box-shadow: 0 0 0 1px #0004; }
  .ba__handle span { position: relative; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #111; display: grid; place-items: center; box-shadow: 0 4px 16px #0006; }
  figcaption { margin-top: var(--s-3); font-size: var(--t-sm); color: var(--c-text-2); }
  figcaption em { color: var(--c-text-3); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((ba) => {
    const h = ba.querySelector<HTMLElement>('[role=slider]')!;
    let pos = 50;
    const set = (p: number) => {
      pos = Math.max(0, Math.min(100, p));
      ba.style.setProperty('--pos', `${pos}%`);
      h.setAttribute('aria-valuenow', String(Math.round(pos)));
      h.setAttribute('aria-valuetext', `${Math.round(pos)}% before`);
    };
    const fromEvent = (e: PointerEvent) => { const r = ba.getBoundingClientRect(); set(((e.clientX - r.left) / r.width) * 100); };
    ba.addEventListener('pointerdown', (e) => { ba.setPointerCapture(e.pointerId); fromEvent(e); h.focus({ preventScroll: true }); });
    ba.addEventListener('pointermove', (e) => { if (ba.hasPointerCapture(e.pointerId)) fromEvent(e); });
    h.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 3;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') set(pos - step);
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') set(pos + step);
      else if (e.key === 'Home') set(0);
      else if (e.key === 'End') set(100);
      else return;
      e.preventDefault();
    });
  });
</script>

---
import Icon from './Icon.astro';
---
<div class="progress" aria-hidden="true"><i data-progress></i></div>
<button type="button" class="to-top" aria-label="Back to top" data-to-top hidden><Icon name="up" /></button>

<style>
  .progress { position: fixed; inset: 0 0 auto 0; height: 2px; z-index: 55; pointer-events: none; }
  .progress i { display: block; height: 100%; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--g-signal); }
  .to-top { position: fixed; left: var(--s-5); bottom: var(--s-5); z-index: 58; width: 48px; height: 48px; display: none; place-items: center; border-radius: 50%; background: var(--c-surface-2); border: 1px solid var(--c-border-strong); transition: background-color var(--d-fast), opacity var(--d-base); }
  .to-top:hover { background: var(--c-surface-3); }
  @media (min-width: 860px) { .to-top:not([hidden]) { display: grid; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const top = document.querySelector<HTMLButtonElement>('[data-to-top]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let ticking = false;
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
    top.hidden = scrollY < innerHeight * 2;
    // Process timeline "fills" as it scrolls through
    document.querySelectorAll<HTMLElement>('[data-fill]').forEach((el) => {
      const r = el.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, (innerHeight * 0.7 - r.top) / r.height));
      el.style.setProperty('--fill', String(p));
    });
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
  top.addEventListener('click', () => scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }));

  // Gentle card tilt (fine pointers, no reduced motion)
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 8}deg`);
        el.style.setProperty('--rx', `${-((e.clientY - r.top) / r.height - 0.5) * 8}deg`);
      });
      el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); });
    });
  }
</script>
